	            -dfs  ---> traverse using depth first search
	            -bfs  ---> traverse using breadth first search
	            -dyn  ---> traverse using dynamic priority based search
	            -ips  ---> traverse using inductive priority search (simple)
	            -ipc  ---> traverse using inductive priority search (complex)
	            -igsc ---> traverse using independent group search (with caching)
	            -ipsb ---> traverse using inductive priority search with local BFS
	            -ipsd ---> traverse using inductive priority search with local DFS
	 
	 phase:     -p    ---> enable phase optimization
	 conflict:  -c    ---> enable conflict detection
